    "parent_id": "incident_2025_05_dns_failure",
    "source": "local_markdown",
    "title": "Incident 2025 05 Dns Failure",
    "text": "An internal DNS misconfiguration caused service-to-service calls to fail across the production cluster for 19 minutes.",
    "section": "Summary",
    "start_char": 0,
    "end_char": 118,
    "path": "data/raw/incidents/incident_2025_05_dns_failure.md",
    "url": null,
    "created_at": null,
    "updated_at": null,
    "service": "search",
    "severity": "sev2",
    "tags": [
      "search"
    ]
  },
  {
    "chunk_id": "46a34d28-d5fb-4fd4-979e-697ab72dfd03",
    "doc_id": "incident_2025_05_dns_failure",
    "parent_id": "incident_2025_05_dns_failure",
    "source": "local_markdown",
    "title": "Incident 2025 05 Dns Failure",
    "text": "All inter-service HTTP calls relying on internal service names failed with connection refused or name resolution errors. Public traffic served by cached routes was unaffected, but any request requiring a live service call returned 502.",
    "section": "Impact",
    "start_char": 0,
    "end_char": 235,
    "path": "data/raw/incidents/incident_2025_05_dns_failure.md",
    "url": null,
    "created_at": null,
    "updated_at": null,
    "service": "search",
    "severity": "sev2",
    "tags": [
